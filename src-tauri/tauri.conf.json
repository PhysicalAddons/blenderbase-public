{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blenderbase",
  "version": "1.2.0",
  "identifier": "com.physicaladdons.blenderbase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blenderbase",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "label": "main",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost https://builder.blender.org https://download.blender.org https://ftp.nluug.nl https://mirror.clarkson.edu https://mirrors.aliyun.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3M0YzMzJBMkRDNzdFMTcKUldRWGZzY3RLak0vaHdVWFg2RlluOWdVVzhSY2tnRmR1NERiNGxrTStVZHpyRE43R3BhYlpsTmsK",
      "endpoints": [
        "https://github.com/PhysicalAddons/blenderbase-public/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}