{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blenderbase",
  "version": "1.3.0",
  "identifier": "com.physicaladdons.blenderbase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blenderbase",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "label": "main",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost https://builder.blender.org https://download.blender.org https://ftp.nluug.nl https://mirror.clarkson.edu https://mirrors.aliyun.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MDM3RUJBM0MzMTA5QjYKUldTMkNURTh1bjREWnlFMThvN2FsTko5OUEzNExUTjBhQTZLU2hOMmJhRkx5M3ZXeW5icFZXbnMK",
      "endpoints": [
        "https://github.com/PhysicalAddons/blenderbase-public/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/main.wxs",
        "fragmentPaths": [
          "wix/ui/BrowseDlg.wxs",
          "wix/ui/CancelDlg.wxs",
          "wix/ui/Common.wxs",
          "wix/ui/DiskCostDlg.wxs",
          "wix/ui/ErrorDlg.wxs",
          "wix/ui/ErrorProgressText.wxs",
          "wix/ui/ExitDialog.wxs",
          "wix/ui/FatalError.wxs",
          "wix/ui/InstallDirDlg.wxs",
          "wix/ui/InvalidDirDlg.wxs",
          "wix/ui/LicenseAgreementDlg.wxs",
          "wix/ui/MaintenanceTypeDlg.wxs",
          "wix/ui/MaintenanceWelcomeDlg.wxs",
          "wix/ui/OutOfDiskDlg.wxs",
          "wix/ui/OutOfRbDiskDlg.wxs",
          "wix/ui/PrepareDlg.wxs",
          "wix/ui/ProgressDlg.wxs",
          "wix/ui/ResumeDlg.wxs",
          "wix/ui/UserExit.wxs",
          "wix/ui/VerifyReadyDlg.wxs",
          "wix/ui/WaitForCostingDlg.wxs",
          "wix/ui/WelcomeDlg.wxs",
          "wix/ui/WixUI_InstallDir.wxs"
        ],
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      }
    }
  }
}
